# Copy and rename this to .env :)

# Port the API listens on, also used by the client in client/.env.example
REACT_APP_SG_PORT=5000

# Folder for the website's JSON files (assets.json, tasks.json)
SG_WEB_DB=./data

# Folder shared with the Blender addon. Contains the wip/ and build/ folders
SG_DATABASE=C:/path/to/shitgrid_database

# Host to bind to. Use 0.0.0.0 to allow the network.
# SG_HOST=127.0.0.1

# Optional, comma separated origins allowed by CORS
# SG_CORS_ORIGIN=http://localhost:3000